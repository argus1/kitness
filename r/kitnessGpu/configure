#!/bin/sh

set -eu

srcdir="${srcdir:-.}"
makevars="${srcdir}/src/Makevars"
nvcc="${NVCC:-$(command -v nvcc 2>/dev/null || true)}"
hipcc="${HIPCC:-$(command -v hipcc 2>/dev/null || true)}"
objects="init.o"
pkg_libs=""
cuda_rule=""
rocm_rule=""
metal_rules=""
metal_target=""

metal_available=""
if test "$(uname -s)" = "Darwin" && command -v xcrun >/dev/null 2>&1 && xcrun --sdk macosx -f metal >/dev/null 2>&1; then
    metal_available="yes"
fi

if test -n "${nvcc}"; then
    cuda_home="${CUDA_HOME:-$(CDPATH= cd -- "$(dirname "${nvcc}")/.." && pwd)}"
    cuda_host_cxx="${CUDA_HOST_CXX:-}"
    host_flag=""
    if test -n "${cuda_host_cxx}"; then
        host_flag="-ccbin ${cuda_host_cxx}"
    fi
    objects="${objects} cuda_bridge.o"
    pkg_libs="${pkg_libs} -L${cuda_home}/lib -Wl,-rpath,${cuda_home}/lib -lcudart"
    cuda_rule="cuda_bridge.o: cuda_bridge.cu
	${nvcc} ${host_flag} -std=c++14 -Xcompiler -fPIC \$(R_XTRA_CPPFLAGS) -I\$(R_INCLUDE_DIR) -c \$< -o \$@"
    echo "configure: CUDA bridge enabled with ${nvcc}"
else
    objects="${objects} cuda_stub.o"
    echo "configure: nvcc not found; building CUDA-unavailable stub"
fi

if test -n "${hipcc}"; then
    rocm_home="${ROCM_HOME:-$(CDPATH= cd -- "$(dirname "${hipcc}")/.." && pwd)}"
    objects="${objects} rocm_bridge.o"
    pkg_libs="${pkg_libs} -L${rocm_home}/lib -Wl,-rpath,${rocm_home}/lib -lamdhip64"
    rocm_rule="rocm_bridge.o: rocm_bridge.cpp
	${hipcc} -std=c++14 -fPIC \$(R_XTRA_CPPFLAGS) -I\$(R_INCLUDE_DIR) -c \$< -o \$@"
    echo "configure: ROCm bridge enabled with ${hipcc}"
else
    objects="${objects} rocm_stub.o"
    echo "configure: hipcc not found; building ROCm-unavailable stub"
fi

if test -n "${metal_available}"; then
    objects="${objects} metal_bridge_m.o"
    pkg_libs="${pkg_libs} -framework Foundation -framework Metal"
    metal_target=" \$(METAL_LIBRARY)"
    metal_rules='METAL = xcrun --sdk macosx metal
METALLIB = xcrun --sdk macosx metallib
METAL_LIBRARY = ../inst/metal/kitness.metallib

metal_bridge_m.o: metal_bridge.mm metal_bridge.h
	$(CXX) $(ALL_CPPFLAGS) $(ALL_CXXFLAGS) -fobjc-arc -c $< -o $@

../inst/metal/vector_add.air: ../inst/metal/vector_add.metal
	$(METAL) -c $< -o $@

$(METAL_LIBRARY): ../inst/metal/vector_add.air
	$(METALLIB) $< -o $@'
    echo "configure: Metal bridge enabled with xcrun"
else
    objects="${objects} metal_stub.o"
    echo "configure: xcrun metal toolchain not found; building Metal-unavailable stub"
fi

cat > "${makevars}" <<EOF
OBJECTS = ${objects}
PKG_LIBS =${pkg_libs}

all: \$(SHLIB)${metal_target}

${cuda_rule}
${rocm_rule}
${metal_rules}
EOF
